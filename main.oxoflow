    { pattern = "{config.out_dir}/bwamem/deduplicated/picard_metrics/{sample}.markdup.sorted.MarkDuplicates.metrics.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml", variables = {} },
]
output = [
